# Copie este arquivo para `.env` e ajuste os valores para o seu ambiente local.
# Nenhuma credencial real deve ser commitada neste arquivo.

# Formato esperado (PostgreSQL). O banco real será configurado no Marco 2.4.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public"


# --- IA opcional na geração de rascunhos (ADR-010) ---
# Só nomes e padrões: NUNCA coloque chaves reais aqui nem no repositório.
# Provedor: mock (padrão, sem rede) | groq | google (adaptador do google ainda não existe: falha na subida).
AI_PROVIDER=mock
# Opcional: sobrescreve o modelo padrão do adaptador (groq: openai/gpt-oss-120b).
AI_MODEL=
# Chave do provedor escolhido (obrigatória se AI_PROVIDER=groq / google; sem ela a API não sobe).
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Tamanho máximo do texto de entrada, em caracteres.
AI_MAX_INPUT_CHARS=8000
# Limite diário de gerações por mentor e teto global da plataforma (contador em memória; dia em America/Sao_Paulo).
AI_DAILY_LIMIT_PER_MENTOR=10
AI_DAILY_LIMIT_GLOBAL=40


# --- Web (apps/web): tela do mentor, /rascunhos/novo (Semana 11, PR 3) ---
# TEMPORÁRIOS até o Marco 3.2 (autenticação): identidade do mentor "de mentira" enviada no corpo do pedido.
# Use ids de teste; NUNCA valores reais de produção. Saem quando houver sessão (Google OAuth, Marco 3.2).
NEXT_PUBLIC_DEMO_ORGANIZATION_ID=
NEXT_PUBLIC_DEMO_MENTOR_ID=
# Para onde o Next repassa /api/draft-questions/* (rewrites no next.config.js). Lida só no servidor do web.
# Padrão: http://localhost:3333 (a API sobe com PORT=3333).
API_PROXY_TARGET=http://localhost:3333
