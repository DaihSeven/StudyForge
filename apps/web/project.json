{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": [
    "scope:web",
    "type:app"
  ],
  "// targets": "to see all targets run: nx show project web --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "tsc --noEmit -p apps/web/tsconfig.json",
          "tsc --noEmit -p apps/web/tsconfig.spec.json"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
