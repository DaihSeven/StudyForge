      ],
      "options": {
        "outputPath": "dist/libs/identity/infra",
        "tsConfig": "libs/identity/infra/tsconfig.lib.json",
        "packageJson": "libs/identity/infra/package.json",
        "main": "libs/identity/infra/src/index.ts",
        "assets": [
          "libs/identity/infra/*.md"
        ]
      }
    }
  }
