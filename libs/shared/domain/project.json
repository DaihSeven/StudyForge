{
  "name": "shared-domain",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/domain/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:domain"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/shared/domain",
        "main": "libs/shared/domain/src/index.ts",
        "tsConfig": "libs/shared/domain/tsconfig.lib.json",
        "assets": [
          "libs/shared/domain/*.md"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "tsc --noEmit -p libs/shared/domain/tsconfig.lib.json",
          "tsc --noEmit -p libs/shared/domain/tsconfig.spec.json"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
